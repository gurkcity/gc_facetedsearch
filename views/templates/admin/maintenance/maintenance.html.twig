{% extends '@Modules/gc_facetedsearch/views/templates/admin/header/moduleheader.html.twig' %}

{% block content %}
<div class="row justify-content-center">
  {% include '@Modules/gc_facetedsearch/views/templates/admin/maintenance/_partials/hooks.html.twig' %}
  {% include '@Modules/gc_facetedsearch/views/templates/admin/maintenance/_partials/tabs.html.twig' %}
  {% include '@Modules/gc_facetedsearch/views/templates/admin/maintenance/_partials/sql.html.twig' %}
  {% include '@Modules/gc_facetedsearch/views/templates/admin/maintenance/_partials/controller.html.twig' %}
  {% include '@Modules/gc_facetedsearch/views/templates/admin/maintenance/_partials/config.html.twig' %}
  {% include '@Modules/gc_facetedsearch/views/templates/admin/maintenance/_partials/orderstate.html.twig' %}
  {% include '@Modules/gc_facetedsearch/views/templates/admin/maintenance/_partials/templates.html.twig' %}
  {% include '@Modules/gc_facetedsearch/views/templates/admin/maintenance/_partials/caching.html.twig' %}

  <div class="col-xl-6">
    <div class="card">
      <h3 class="card-header">
        <i class="material-icons">extension</i> {{ 'Plugins'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}
      </h3>
      <div class="card-body">
        {% for plugin in plugins %}
          <div class="plugin-item">
            <h4>{{ plugin.name }}</h4>
            <p>{{ plugin.description }}</p>
            <p>
              {{ 'Hooks:'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}
            </p>
            <ul class="list-unstyled">
              {% for hook in plugin.hooks %}
              <li>{{ hook }}</li>
              {% endfor %}
            </ul>
          </div>
        {% else %}
          <p class="alert alert-info">{{ 'There are no plugins available.'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</p>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="col-xl-6">
    <div class="card">
      <h3 class="card-header">
        <i class="material-icons">settings</i> {{ 'Advanced Options'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}
      </h3>
      <div class="card-body">
        <p>
          <a id="btn_change_license_code" class="btn btn-default" href="{{ path('gc_facetedsearch_license') }}">{{ 'Change license code'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</a>
        </p>
        <ul class="list-unstyled">
          <li>PHP Version: <b>{{ php_version }}</b></li>
          <li>Module Version: <b>{{ module_version }}</b></li>
          <li>GC Module Version: <b>{{ module_gcversion }}</b></li>
          <li>GC Module Subversion: <b>{{ module_gcsubversion }}</b></li>
        </ul>
      </div>
    </div>
  </div>
</div>

{% endblock %}
