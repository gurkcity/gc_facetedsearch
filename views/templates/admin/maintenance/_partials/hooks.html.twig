<div class="col-xl-6">
  <div class="card">

    <h3 class="card-header">
      <i class="material-icons">anchor</i> {{ 'Hooks'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}
    </h3>

    <div class="card-body">
      <p>{{ 'This list shows all hooks used by the module. If not all hooks are registered, you can fix this with the button below.'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</p>

      {% include '@Modules/gc_facetedsearch/views/templates/admin/maintenance/_partials/multishop.html.twig' %}

      {% if hooks.module is not empty %}
      <table class="hooks_list table table-sm table-responsive">
        <thead>
          <tr>
            <th>{{ 'Status'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</th>
            <th>{{ 'Hook Name'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</th>
            {% if hooks.positions_exists %}
              <th>{{ 'Position'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</th>
            {% endif %}
          </tr>
        </thead>
        <tbody>
          {% for hook in hooks.module %}
          <tr>
            <td>
              {% if not hook.registered %}
              <span class="badge badge-danger">{{ 'not registered!'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</span>
              {% else %}
              <span class="badge badge-success">{{ 'ok'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</span>
              {% endif %}
            </td>
            <td>{{ hook.name }}</td>
            {% if hooks.positions_exists %}
              <td>
                {% if hook.position == '' %}
                  <span class="text-muted">{{ 'no position'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</span>
                {% elseif hook.position == 'top' %}
                  {{ 'Top'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}
                {% elseif hook.position == 'bottom' %}
                  {{ 'Bottom'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}
                {% else %}
                  {{ hook.position }}
                {% endif %}
              </td>
            {% endif %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="alert alert-info">{{ 'There are no hooks for this module to register'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</p>
      {% endif %}

      {% if hooks.unnecessary is not empty %}
      <table class="hooks_list_unnecessary table table-sm table-responsive">
        <thead>
          <tr>
            <th>{{ 'Status'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</th>
            <th>{{ 'Hook Name'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</th>
          </tr>
        </thead>
        <tbody>
          {% for hook_name in hooks.unnecessary %}
          <tr>
            <td>
              <span class="badge badge-warning">{{ 'registerd but unnecessary!'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</span>
            </td>
            <td>{{ hook_name }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </div>

    <div class="card-footer">
      <div class="d-flex justify-content-end">
        <a class="btn btn-primary" href="{{ path('gc_facetedsearch_maintenance_hooks_reset') }}">{{ 'Reset missing hooks'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</a>
      </div>
    </div>

  </div>
</div>
