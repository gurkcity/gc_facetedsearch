{% extends '@Modules/gc_facetedsearch/views/templates/admin/header/moduleheader.html.twig' %}
{% form_theme filterTemplateForm '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

{% block content %}
  {{ form_start(filterTemplateForm) }}
    <div class="row justify-content-center">
      <div class="col-xl-12">
        <div class="card">
          <h3 class="card-header">
            <i class="material-icons">settings</i> {{ layoutTitle }}
          </h3>

            <div class="card-body">
                <div class="form-wrapper">
                    {{ form_widget(filterTemplateForm) }}
                </div>
            </div>

          <div class="card-footer">
            <div class="d-flex justify-content-between">
                <a href="{{ path('gc_facetedsearch_configuration') }}" class="btn btn-outline-secondary">
                    {{ 'Cancel'|trans({}, 'Admin.Actions') }}
                </a>
                <button class="btn btn-primary">{{ 'Save'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  {{ form_end(filterTemplateForm) }}
{% endblock %}

{% block extra_javascripts %}
  {{ parent() }}
  <script>
  $(() => {
    window.prestashop.component.initComponents(
      [
        'MultistoreConfigField',
        'TranslatableInput',
        'ChoiceTree',
      ],
    );

    new window.prestashop.component.ChoiceTree('#filter_template_categories');
  });
  </script>
{% endblock %}
