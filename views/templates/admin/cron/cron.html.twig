{% extends '@Modules/gc_facetedsearch/views/templates/admin/header/moduleheader.html.twig' %}

{% block content %}
  <div class="row justify-content-center">
    <div class="col-xl-12">
      <div class="card">
        <h3 class="card-header">
          <i class="material-icons">settings</i> {{ 'Indexes and caches'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}
        </h3>

        <div class="card-body">
          <div class="">
            <p>
              <a class="ajaxcall-recurcive btn btn-default" href="{{ price_indexer_url }}">{{ 'Index all missing prices'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</a>
              <a class="ajaxcall-recurcive btn btn-default" href="{{ full_price_indexer_url }}">{{ 'Rebuild entire price index'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</a>
              <a class="ajaxcall btn btn-default" href="{{ attribute_indexer_url }}">{{ 'Build attributes and features indexes'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</a>
              <a class="ajaxcall-recurcive btn btn-default" href="{{ best_sales_indexer_url }}">{{ 'Build best sales index'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</a>
              <a class="ajaxcall btn btn-default" href="{{ clear_cache_url }}">{{ 'Clear cache'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</a>
            </p>
          </div>

          <div class="alert alert-info">
            <p>{{ 'We recommend to set regular cron tasks to manage the indexes and cache on daily/weekly basis.'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</p>
            <br>
            {{ 'Add missing products to price index:'|trans({}, 'Modules.Gcfacetedsearch.Admin') }} <strong>{{ price_indexer_url_for_cron }}</strong>
            <br>
            {{ 'Rebuild price index:'|trans({}, 'Modules.Gcfacetedsearch.Admin') }} <strong>{{ full_price_indexer_url_for_cron }}</strong>
            <br>
            {{ 'Rebuild attribute index:'|trans({}, 'Modules.Gcfacetedsearch.Admin') }} <strong>{{ attribute_indexer_url_for_cron }}</strong>
            <br>
            {{ 'Rebuild bestsales index:'|trans({}, 'Modules.Gcfacetedsearch.Admin') }} <strong>{{ best_sales_indexer_url_for_cron }}</strong>
            <br>
            {{ 'Flush block cache:'|trans({}, 'Modules.Gcfacetedsearch.Admin') }} <strong>{{ clear_cache_url_for_cron }}</strong>
            <br>
            <br>
            {{ 'A nightly rebuild is recommended.'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block extra_javascripts %}
  {{ parent() }}
  <script>
  var translations = new Object();

  translations.in_progress = '{{ '(in progress)'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}';
  translations.url_indexation_finished = '{{ 'URL indexing finished'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}';
  translations.attribute_indexation_finished = '{{ 'Attribute indexing finished'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}';
  translations.url_indexation_failed = '{{ 'URL indexing failed'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}';
  translations.attribute_indexation_failed = '{{ 'Attribute indexing failed'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}';
  translations.price_indexation_finished = '{{ 'Price indexing finished'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}';
  translations.price_indexation_failed = '{{ 'Price indexing failed'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}';
  translations.price_indexation_in_progress = '{{ '(in progress, %s products price to index)'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}';
  translations.loading = '{{ 'Loading...'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}';
  translations.delete_all_filters_templates = '{{ 'You selected -All categories-: all existing filter templates will be deleted. Is it OK?'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}';
  translations.no_selected_categories = '{{ 'You must select at least one category'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}';
  translations.no_selected_controllers = '{{ 'You must select at least one page'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}';
  </script>
{% endblock %}
