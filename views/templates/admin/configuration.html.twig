{% extends '@Modules/gc_facetedsearch/views/templates/admin/header/moduleheader.html.twig' %}
{% form_theme form '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

{% block content %}
  {{ form_start(form) }}
    <div class="row justify-content-center">
      <div class="col-xl-12">
        <div class="card">
          <h3 class="card-header">
            <i class="material-icons">settings</i> {{ 'Configuration'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}
          </h3>

          <div class="card-body">
            <div class="form-wrapper">
              {{ form_row(form.CACHE_ENABLED) }}
              {{ form_row(form.SHOW_QUIES) }}
              {{ form_row(form.FULL_TREE) }}
              {{ form_row(form.FILTER_BY_DEFAULT_CATEGORY) }}
              {{ form_row(form.FILTER_CATEGORY_DEPTH) }}
              {{ form_row(form.FILTER_PRICE_USETAX) }}
              {{ form_row(form.FILTER_PRICE_ROUNDING) }}
              {{ form_row(form.FILTER_SHOW_OUT_OF_STOCK_LAST) }}
              {{ form_row(form.USE_JQUERY_UI_SLIDER) }}
              {{ form_row(form.DEFAULT_CATEGORY_TEMPLATE) }}
              {{ form_row(form.OMIT_COUNTRIES) }}
            </div>
          </div>

          <div class="card-footer">
            <div class="d-flex justify-content-end">
              <button class="btn btn-primary">{{ 'Save'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-xl-12">
        <div class="card">
          <h3 class="card-header">
            <i class="material-icons">settings</i> {{ 'Sort by'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}
          </h3>

          <div class="card-body">
            <div class="form-wrapper">
              {{ form_row(form.POSITION_SORTING) }}
              {{ form_row(form.BEST_SALES_SORTING) }}
              {{ form_row(form.BEST_SALES_DAYS) }}
              {{ form_row(form.DATE_ADD_SORTING) }}
              {{ form_row(form.PRICE_LOW_TO_HIGH_SORTING) }}
              {{ form_row(form.PRICE_HIGH_TO_LOW_SORTING) }}
              {{ form_row(form.QUANTITY_SORTING) }}
              {{ form_row(form.PRODUCT_REFERENCE_ASC_SORTING) }}
              {{ form_row(form.PRODUCT_REFERENCE_DESC_SORTING) }}
            </div>
          </div>

          <div class="card-footer">
            <div class="d-flex justify-content-end">
              <button class="btn btn-primary">{{ 'Save'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-xl-12">
        <div class="card">
          <h3 class="card-header">
            <i class="material-icons">settings</i> {{ 'Theme settings'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}
          </h3>

          <div class="card-body">
            <div class="form-wrapper">
              {{ form_rest(form) }}
            </div>
          </div>

          <div class="card-footer">
            <div class="d-flex justify-content-end">
              <button class="btn btn-primary">{{ 'Save'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  {{ form_end(form) }}
{% endblock %}

{% block extra_javascripts %}
  {{ parent() }}
  <script>
  $(() => {
    window.prestashop.component.initComponents(
      [
        'MultistoreConfigField',
        'TranslatableInput',
      ],
    );
  });
  </script>
{% endblock %}
