{% extends '@Modules/gc_facetedsearch/views/templates/admin/header/moduleheader.html.twig' %}
{% form_theme form '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

{% block content %}
  {{ form_start(form) }}
    <div class="row justify-content-center">
      <div class="col-xl-12">
        <div class="card">
          <h3 class="card-header">
            <i class="material-icons">settings</i> {{ 'Configuration'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}
          </h3>

          <div class="card-body">
            <div class="form-wrapper">
              {{ form_widget(form) }}
            </div>
          </div>

          <div class="card-footer">
            <div class="d-flex justify-content-end">
              <button class="btn btn-primary">{{ 'Save'|trans({}, 'Modules.Gcfacetedsearch.Admin') }}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  {{ form_end(form) }}
{% endblock %}

{% block extra_javascripts %}
  {{ parent() }}
  <script>
  $(() => {
    window.prestashop.component.initComponents(
      [
        'MultistoreConfigField',
        'TranslatableInput',
      ],
    );
  });
  </script>
{% endblock %}
